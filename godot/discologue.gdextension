[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../discologue-client/target/debug/libdiscologue_client.so"
linux.release.x86_64 =   "res://../discologue-client/target/release/libdiscologue_client.so"
windows.debug.x86_64 =   "res://../discologue-client/target/debug/libdiscologue_client.dll"
windows.release.x86_64 = "res://../discologue-client/target/release/libdiscologue_client.dll"
macos.debug =            "res://../discologue-client/target/debug/libdiscologue_client.dylib"
macos.release =          "res://../discologue-client/target/release/libdiscologue_client.dylib"
macos.debug.arm64 =      "res://../discologue-client/target/debug/libdiscologue_client.dylib"
macos.release.arm64 =    "res://../discologue-client/target/release/libdiscologue_client.dylib"
